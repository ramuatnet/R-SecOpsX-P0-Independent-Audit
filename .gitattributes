# tests/replay artifacts are byte-compared by gates (emitter --check,
# the golden diff in analysis/validation/replay.py). core.autocrlf=true
# on a Windows checkout must never rewrite them, or every fresh clone
# would go red on line endings alone.
tests/replay/** text eol=lf

# FND-08: the baseline fixtures are byte-compared against a SHA manifest
# (tests/test_report_parity.py, report_audit --baseline).  CRLF
# normalization at add-time would make every fresh clone fail the hash.
tests/fixtures/baseline/** -text

# DEV-1: the vendored CycloneDX schema fixture is byte-compared against
# pinned SHA-256 values (schemas/cyclonedx/1.6/MANIFEST.json, verified at
# every load by analysis/validation/sbom_conformance.py). CRLF conversion
# at checkout would make every fresh clone fail the hash. Same convention
# as the FND-08 baseline fixtures above.
schemas/** -text
