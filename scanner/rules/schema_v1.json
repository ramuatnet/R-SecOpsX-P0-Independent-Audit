{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rsecopsx.rules/v1",
  "title": "R-SecOpsX declarative rule file v1",
  "type": "object",
  "required": ["schema", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "rsecopsx.rules/v1" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["id", "title", "family", "severity", "cwe", "owasp",
                   "pattern", "span", "exts", "negative"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,}$" },
        "title": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["Critical", "High", "Medium", "Low", "Info"] },
        "langs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9_+-]+$" }
        },
        "cwe": { "type": "string", "minLength": 1 },
        "owasp": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "span": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "negative": { "type": ["string", "null"] },
        "flags": { "type": "string", "pattern": "^[ims]*$" },
        "evidence_pat": { "type": "string", "minLength": 1 },
        "sink_category": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "contract_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "sanitizers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "barriers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "remediation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string" },
        "disabled": { "type": "boolean" }
      }
    }
  }
}
