def _compute_exploitability(f: dict, sbom: list | None = None) -> str:
    """
    Issue 6 FIX: derive exploitability from taint evidence, EPSS, and context.
    Priority: taint trace > EPSS from related SBOM > heuristic.
    """
    # Taint-confirmed data flow = highest exploitability
    taint = f.get("taint_path", "")
    if taint and "->" in taint:
        return "High"
    # EPSS-based: if a related SBOM CVE has EPSS > 0.5 High
    if sbom:
        vt = f.get("vuln_type","")
        for pkg in sbom:
            epss = float(pkg.get("epss") or 0)
            if epss >= 0.5 and pkg.get("reachable"):
                # Log4Shell EPSS=0.975, Spring4Shell=0.970 override to High
                if vt in ("insecure_deserialization","command_injection","code_injection"):
                    return "High"
    # Source-name heuristic
    source = f.get("source_expr", "") or ""
    if any(s in source.lower() for s in ("request", "input", "argv", "form", "query", "param")):
        return "Medium"
    return f.get("exploitability") or "Low"


def _compute_exploitability_legacy(f: dict) -> str:
    """
    Determine exploitability based on evidence quality:
      HIGH   — real taint path confirms user-controlled data reaches the sink
      MEDIUM — source name suggests user input but flow is not fully traced
      LOW    — pattern match only, no user-input evidence
    """
    taint = f.get("taint_path", "")
    if taint and "->" in taint:
        return "High"
    source = f.get("source_expr", "") or ""
    if any(s in source.lower() for s in ("request", "input", "argv", "form", "query", "param")):
        return "Medium"
    # Fall back to mapper value if available, else Low
    return f.get("exploitability") or "Low"



def _is_blankish(value) -> bool:
    text = str(value or "").strip().lower()
    return text in {"", "none", "null", "n/a", "na", "not applicable", "unknown"}



def _infer_engine_name(f: dict) -> str:
    """Correct accidental engine overwrite while preserving true scanner source."""
    existing = str(f.get("engine") or "").strip()
    title = str(f.get("title") or "").lower()
    rid = str(f.get("rule_id") or "").lower()
    vt = str(f.get("vuln_type") or "").lower()
    detection = str(f.get("detection") or "").lower()

    secret_tokens = ("secret", "credential", "password", "token", "api key", "connection string", "private key")
    is_secret = vt in {"hardcoded_secret", "secret_exposure", "jwt_secret", "connection_string", "oauth_client_secret", "database_connection_string"} or any(x in title for x in secret_tokens)

    # Only trust scanner.secret_intelligence for real secret findings. Older patches
    # accidentally stamped every finding with scanner.secret_intelligence.
    if existing == "scanner.secret_intelligence" and not is_secret:
        existing = ""

    if existing:
        return existing
    if f.get("taint_path") and "->" in str(f.get("taint_path")):
        return "scanner.taint_engine"
    if "taint" in detection:
        return "scanner.taint_engine"
    if "api_abuse" in rid or "rate limit" in title or vt in {"api_rate_limit", "api_abuse_missing_rate_limit"}:
        return "analysis.api_abuse_risk_engine"
    if any(x in vt or x in rid or x in title for x in ["idor", "bola", "tenant", "workflow", "privilege_escalation"]):
        return "analysis.data_flow_correlation_engine"
    if any(x in title or x in rid for x in ["spring", "asp.net", "graphql", "express", "webflux", "actuator"]):
        return "analysis.framework_enrichment_engine" if "framework" in detection else "scanner.sast"
    if is_secret:
        return "scanner.secret_intelligence"
    if any(x in detection for x in ["sast", "pattern", "regex"]):
        return "scanner.sast"
    return "scanner.sast"

