def _root_cause_family(f: dict) -> str:
    """Broad remediation-family grouping for executive root-cause reporting."""
    text = " ".join(str(f.get(k, "")) for k in (
        "title", "vuln_type", "rule_id", "cwe", "owasp", "description", "snippet"
    )).lower()

    if any(x in text for x in [
        "deserialization", "deserialize", "objectinputstream", "binaryformatter",
        "typenamehandling", "xstream", "snakeyaml", "unserialize", "phar", "gob"
    ]):
        return "Insecure Deserialization"
    if any(x in text for x in [
        "command injection", "code injection", "exec", "eval", "new function",
        "child_process", "spel", "template injection", "jndi", "log4shell", "shell"
    ]):
        return "Command / Code Injection"
    if any(x in text for x in ["sql", "hql", "jpql", "nosql", "fromsqlraw", "query injection", "orm"]):
        return "SQL / ORM / NoSQL Injection"
    if any(x in text for x in ["ssrf", "server-side request forgery", "metadata", "outbound request"]):
        return "Server-Side Request Forgery"
    if any(x in text for x in [
        "idor", "bola", "mass assignment", "overposting", "open redirect",
        "tenant", "privilege", "workflow", "approval", "csrf", "access control"
    ]):
        return "Broken Access Control / Business Logic"
    if any(x in text for x in ["secret", "credential", "password", "token", "private key", "api key"]):
        return "Secrets / Credential Exposure"
    if any(x in text for x in ["tls", "insecureskipverify", "trustmanager", "hostnameverifier", "md5", "sha-1", "crypto"]):
        return "Cryptographic Weakness"
    if any(x in text for x in ["redos", "rate limit", "resource exhaustion", "readall", "query depth", "complexity"]):
        return "Resource Exhaustion / ReDoS"
    if any(x in text for x in ["prototype pollution", "unsafe merge", "object merge"]):
        return "Broken Access Control / Business Logic"
    if any(x in text for x in ["race", "toctou", "shared map", "duplicate action", "check then act"]):
        return "Race Conditions / TOCTOU"
    if any(x in text for x in ["actuator", "xxe", "dtd", "misconfiguration", "exposed", "debug", "security configuration", "missing @valid", "missing validation", "@validated"]):
        return "Security Misconfiguration"
    if any(x in text for x in ["path traversal", "zipslip", "zip slip", "file traversal", "filepath.join"]):
        return "Path Traversal / Unsafe File Access"
    if any(x in text for x in ["xss", "cross-site scripting", "raw echo", "innerhtml", "document.write"]):
        return "Cross-Site Scripting"
    return "Security Misconfiguration / Secure Coding"

def _top_root_causes(grouped: list[dict], n: int = 5) -> list[dict]:
    """Top-N remediation families by total occurrence count.

    The detailed findings remain deduplicated by precise rule/evidence, but the
    executive priority table groups them into broad fix families so management
    sees useful remediation leverage instead of one-off rule titles.
    """
    families: dict[str, dict] = {}
    for f in grouped or []:
        family = _root_cause_family(f)
        entry = families.setdefault(family, {
            "title": family,
            "severity": "Info",
            "instances": 0,
            "affected_files": [],
            "risk_score": 0,
            "representative_findings": [],
        })
        entry["instances"] += int(f.get("instances", 1) or 1)
        files = f.get("affected_files") or [f.get("file", "")]
        for fp in files:
            if fp and fp not in entry["affected_files"]:
                entry["affected_files"].append(fp)
        if SEVERITY_ORDER.get(f.get("severity", "Info"), 99) < SEVERITY_ORDER.get(entry.get("severity", "Info"), 99):
            entry["severity"] = f.get("severity", "Info")
        entry["risk_score"] = max(_safe_float(entry.get("risk_score")), _safe_float(f.get("risk_score")))
        if len(entry["representative_findings"]) < 5:
            entry["representative_findings"].append(f.get("title", ""))

    return sorted(
        families.values(),
        key=lambda x: (int(x.get("instances", 0)), _safe_float(x.get("risk_score"))),
        reverse=True,
    )[:n]


def _finalize_occurrence_integrity(findings: list[dict]) -> list[dict]:
    """Rebuild occurrence-derived report fields from final retained occurrences.

    This is intentionally the last normalization step before scoring/reporting.
    No aggregate field (instances, occurrence_count, unique_file_count,
    affected_files, evidence) is trusted from an earlier engine stage.
    """
    finalized = []
    for finding in findings:
        f = dict(finding)
        raw_occs = f.get("occurrences") or [_occurrence_from_finding(f)]
        occs, seen = [], set()
        for occ in raw_occs:
            if not isinstance(occ, dict):
                continue
            file_value = str(occ.get("file") or occ.get("file_path") or occ.get("full_path") or f.get("file") or "")
            line_value = occ.get("line")
            key = (file_value, line_value, str(occ.get("snippet") or occ.get("evidence") or ""))
            if key in seen:
                continue
            seen.add(key)
            item = dict(occ)
            item["file"] = file_value
            item["file_path"] = str(item.get("file_path") or file_value)
            item["full_path"] = str(item.get("full_path") or file_value)
            item.setdefault("file_name", file_value.replace("\\", "/").split("/")[-1])
            occs.append(item)
        if not occs:
            continue
        f["occurrences"] = occs
        f["affected_files"] = list(dict.fromkeys(o["file"] for o in occs if o.get("file")))
        f["instances"] = len(occs)
        f["occurrence_count"] = len(occs)
        f["unique_file_count"] = len(f["affected_files"])
        f["file_count"] = len(f["affected_files"])

        # The retained occurrences are the sole source of truth for the
        # representative/evidence fields.  Earlier engine/grouping stages may
        # have left stale evidence from occurrences that were later pruned.
        # Rebuild those fields BEFORE EVIDEX validation so validation cannot
        # accidentally validate stale evidence.
        representative = occs[0]
        for key in ("file", "file_path", "full_path", "file_name", "line", "snippet",
                    "taint_path", "detection", "sink_category"):
            if key in representative and representative.get(key) not in (None, ""):
                f[key] = representative[key]

        final_evidence = []
        for occ in occs:
            for key in ("evidence", "snippet", "taint_path", "detection"):
                value = occ.get(key)
                if isinstance(value, (list, tuple)):
                    values = value
                else:
                    values = [value]
                for value in values:
                    text = str(value or "").strip()
                    if text and text not in final_evidence:
                        final_evidence.append(text)
        f["evidence"] = final_evidence

        # Re-run evidence validation against ONLY the final occurrences.
        result = _validate_security_evidence(f)
        f["evidence_validation_detail"] = result
        f["evidence_validation"] = result.get("reason", "")
        f["evidence_valid"] = bool(result.get("valid"))
        f["evidence_score"] = int(result.get("evidence_score", 0))
        f["evidence_quality"] = int(result.get("evidence_score", 0))
        f["evidence_reason"] = result.get("reason", "")
        f["sink_validated"] = bool(result.get("sink_valid"))
        f["sink_category"] = _evidex_infer_sink_category(f, result)
        # Replace stale top-level evidence with the validator's final evidence.
        f["evidence"] = list(result.get("evidence") or [])

        if not f.get("evidence_valid") and str(f.get("finding_class") or "").lower() == "confirmed":
            continue
        finalized.append(f)
    return finalized


def build_report_payload(findings: list[dict], sbom: list[dict],
                         target_path: str) -> dict[str, Any]:
    findings = adapt_findings(findings)
    deduped  = deduplicate(findings)
    # Issue 2 FIX: drop any finding that enrich_finding signals as invalid
    # (returns {} for IDOR with http sink_category)
    # V17.9: enrich/calibrate canonical severity and exploitability BEFORE scoring.
    # Previously score_finding() ran first, so a later severity calibration
    # (for example Low -> Medium for a taint-validated path traversal) changed
    # the displayed severity but left the score_breakdown using the old factor.
    enriched = []
    for f in deduped:
        e = enrich_finding(f)
        if not e or not e.get("vuln_type"):
            continue
        e = score_finding(e)
        if e.get("vuln_type"):
            enriched.append(e)

    # FINAL REPORT INTEGRITY PASS (V8 Enterprise): occurrence data is the
    # authoritative source of truth.  Rebuild all occurrence-derived fields
    # and EVIDEX evidence after every dedupe/pruning operation so stale
    # aggregate counters/evidence from pre-pruned detections cannot survive.
    enriched = _finalize_occurrence_integrity(enriched)
    grouped  = group_by_severity(enriched)

    scored_sbom = [_score_sbom_entry(p) for p in sbom]

    vulnerable_sbom = [
        p for p in scored_sbom
        if (
            _safe_float(p.get("cvss")) > 0
            or p.get("cve")
            or p.get("vulnerabilities")
        )
    ]
    # Risk score reflects severity of root-cause vulnerabilities.
    # Dedup ratio is reported separately in metadata for transparency
    # but does NOT reduce the score — same vulns = same risk regardless of file count.
    total_occ  = sum(f.get("instances", 1) for f in enriched)
    n_roots    = len(enriched)
    portfolio = compute_portfolio_score(enriched + vulnerable_sbom)
    dist         = severity_distribution(enriched)
    owasp        = _build_owasp_summary(enriched)
    mitre        = _build_mitre_summary(enriched)
    attack_paths = get_attack_paths(enriched)
    insights     = generate_insights(enriched, scored_sbom, attack_paths)

    return {
        "metadata": {
            "tool":                  TOOL_FULL,
            "target":                target_path,
            "scan_date":             datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "total_findings": len(enriched) + len(vulnerable_sbom),
            "sast_findings":         len(enriched),
            "sca_findings":          len(vulnerable_sbom),
            "risk_score":            portfolio,
            "dedup_ratio":           round(n_roots / total_occ, 2) if total_occ else 1.0,
            "dedup_root_count":      n_roots,
            "dedup_occurrence_count": total_occ,
            "dedup_ratio_semantics":  "SAST_ROOT_FINDINGS_DIVIDED_BY_SAST_OCCURRENCES",

            "risk_score_model":      SCORING_MODEL_DESCRIPTION,
            "severity_distribution": dist,
        },
        "findings":     enriched,
        "grouped":      grouped,
        "owasp":        owasp,
        "mitre":        mitre,
        "attack_paths": attack_paths,
        "sbom":         scored_sbom,
        "insights":     insights,
        "top_root_causes": _top_root_causes(grouped),
    }


# ---- final dedupe/executive merge patch ----
def _merge_semantic_duplicate_findings(findings: list[dict]) -> list[dict]:
    out = []
    spel_seen = None
    for f in findings:
        text = " ".join(str(f.get(k, "")) for k in ("rule_id", "title", "vuln_type", "file")).lower()
        if "spel" in text:
            if spel_seen is None:
                g = dict(f)
                g["title"] = "Spring SpEL Injection (Pattern + Taint Confirmed)" if str(g.get("detection","")).upper() == "TAINT-VALIDATED" or g.get("taint_path") else g.get("title")
                spel_seen = g
                out.append(g)
            else:
                if str(f.get("detection", "")).upper() == "TAINT-VALIDATED" or f.get("taint_path"):
                    spel_seen.update({k: v for k, v in f.items() if k in {"detection", "taint_path", "exploitability", "confidence", "risk_score"} and v})
                    spel_seen["title"] = "Spring SpEL Injection (Pattern + Taint Confirmed)"
                    occ = spel_seen.setdefault("occurrences", [])
                    occ.extend(f.get("occurrences", [_occurrence_from_finding(f)]))
                    spel_seen["instances"] = len(occ)
                continue
        else:
            out.append(f)
    return out

# ---- final enterprise QA polish: occurrence paths + language-safe impacts ----
def _qa_normalize_occurrences(findings: list[dict]) -> list[dict]:
    for f in findings:
        occs = f.get("occurrences") or [_occurrence_from_finding(f)]
        fixed = []
        seen = set()
        for occ in occs:
            if not isinstance(occ, dict):
                continue
            file_value = occ.get("file") or occ.get("file_path") or occ.get("full_path") or f.get("file", "")
            full_value = occ.get("full_path") or file_value
            key = (file_value, occ.get("line"))
            if key in seen:
                continue
            seen.add(key)
            new_occ = dict(occ)
            new_occ["file"] = file_value
            new_occ["full_path"] = full_value
            new_occ.setdefault("file_path", file_value)
            new_occ.setdefault("file_name", str(file_value).replace("\\", "/").split("/")[-1])
            fixed.append(new_occ)
        f["occurrences"] = fixed or [_occurrence_from_finding(f)]
        f["affected_files"] = list(dict.fromkeys(o.get("file", "") for o in f["occurrences"] if o.get("file")))
        f["instances"] = len(f["occurrences"])
    return findings

