def _apply_compliance_fallbacks(f: dict) -> None:
    vt = str(f.get("vuln_type") or "").lower()
    title = str(f.get("title") or "").lower()
    if vt not in _COMPLIANCE_BY_VULN:
        if "mass assignment" in title or "overposting" in title:
            vt = "mass_assignment"
        elif "xxe" in title or "dtd" in title:
            vt = "xxe"
        elif "rate limit" in title:
            vt = "api_rate_limit"
    for k, v in _COMPLIANCE_BY_VULN.get(vt, {}).items():
        if _is_blankish(f.get(k)):
            f[k] = v


def _infer_detection_label(f: dict) -> str:
    """Stable report-facing detection label. Never allow Not Applicable."""
    existing = f.get("detection")
    if not _is_blankish(existing):
        if str(existing).strip() == "AST Taint Analysis":
            return "TAINT-VALIDATED"
        return str(existing).strip()

    engine = str(f.get("engine") or "").lower()
    vt = str(f.get("vuln_type") or f.get("rule_id") or "").lower()
    title = str(f.get("title") or "").lower()

    if f.get("taint_path") and "->" in str(f.get("taint_path")):
        return "TAINT-VALIDATED"
    if "taint" in engine:
        return "Enterprise Source-to-Sink Heuristic"
    if "framework" in engine:
        return "Framework-Aware Static Enrichment"
    if "api_abuse" in engine or "api abuse" in title or "rate limit" in title:
        return "API Abuse Heuristic"
    if "data_flow" in engine or "idor" in vt or "tenant" in vt or "workflow" in vt:
        return "Data Flow Correlation"
    if "kubernetes" in engine or vt.startswith("k8s"):
        return "Kubernetes IaC Static Analysis"
    if "terraform" in engine or vt.startswith("tf"):
        return "Terraform IaC Static Analysis"
    if "docker" in engine or vt.startswith("docker"):
        return "Dockerfile IaC Static Analysis"
    if "secret" in engine or "secret" in vt:
        return "Enterprise Secret Intelligence"
    if "llm" in engine or "llm" in vt or "llm" in title:
        return "LLM Security Heuristic"
    return "Enterprise SAST Pattern"


def _infer_owasp_value(f: dict) -> str:
    """Preserve/infer OWASP category instead of allowing summary collapse to Unknown/A08."""
    existing = f.get("owasp") or f.get("owasp_top10_2021")
    if not _is_blankish(existing):
        if isinstance(existing, list):
            return str(existing[0]) if existing else "A05:2021 - Security Misconfiguration"
        return str(existing)
    text = " ".join(str(f.get(k, "")) for k in ("title", "vuln_type", "rule_id", "cwe", "description", "snippet")).lower()
    if "llm" in text or "prompt" in text:
        # Never guess a numbered entry here: the text match is too broad to
        # distinguish risks, and the previous value asserted an ID/title pair
        # that exists in no OWASP edition.  An unclassified label keeps the
        # finding in the OWASP view without inventing a risk ID.
        return "OWASP LLM / Agentic AI Security - unclassified"
    if any(x in text for x in ["sql", "injection", "exec", "eval", "spel", "command", "template"]):
        return "A03:2021 - Injection"
    if any(x in text for x in ["deserialization", "serialize", "objectinputstream", "binaryformatter", "typenamehandling", "phar", "xstream", "snakeyaml"]):
        return "A08:2021 - Software and Data Integrity Failures"
    if any(x in text for x in ["ssrf", "server-side request forgery"]):
        return "A10:2021 - Server-Side Request Forgery"
    if any(x in text for x in ["csrf", "idor", "bola", "mass assignment", "overposting", "open redirect", "tenant", "privilege", "workflow"]):
        return "A01:2021 - Broken Access Control"
    if any(x in text for x in ["tls", "insecureskipverify", "trustmanager", "hostnameverifier", "md5", "sha-1", "crypto"]):
        return "A02:2021 - Cryptographic Failures"
    if any(x in text for x in ["actuator", "xxe", "dtd", "misconfiguration", "exposed", "debug"]):
        return "A05:2021 - Security Misconfiguration"
    if any(x in text for x in ["redos", "rate limit", "resource exhaustion", "readall"]):
        return "API4:2023 - Unrestricted Resource Consumption"
    return "A05:2021 - Security Misconfiguration"


def _owasp_id_and_category(value: str) -> tuple[str, str]:
    text = str(value or "").strip()
    if not text:
        return "Unknown", "Unknown"
    if ":" in text:
        oid, rest = text.split(":", 1)
        oid = oid.strip()
        return oid, f"{oid}:{rest.strip()}"
    return text.split()[0], text


def _build_owasp_summary(findings: list[dict]) -> dict:
    out: dict[str, dict] = {}
    for f in findings:
        val = _infer_owasp_value(f)
        oid, cat = _owasp_id_and_category(val)
        out.setdefault(oid, {"category": cat, "count": 0})
        out[oid]["count"] += 1
    return out


def _build_mitre_summary(findings: list[dict]) -> list[dict]:
    descriptions = {
        "T1059": "Command and Scripting Interpreter",
        "T1190": "Exploit Public-Facing Application",
        "T1566": "Phishing",
        "T1083": "File and Directory Discovery",
        "T1189": "Drive-by Compromise",
        "T1552": "Unsecured Credentials",
        "T1600": "Weaken Encryption",
        "T1203": "Exploitation for Client Execution",
        "T1557": "Adversary-in-the-Middle",
        "T1068": "Exploitation for Privilege Escalation",
        "T1195": "Supply Chain Compromise",
    }
    seen = []
    for f in findings:
        val = f.get("mitre") or f.get("mitre_attack")
        vals = val if isinstance(val, list) else [val]
        for v in vals:
            tid = str(v or "").strip()
            if not tid or tid.lower() in {"none", "not applicable", "n/a", "na"}:
                continue
            if tid not in seen:
                seen.append(tid)
    return [{"id": tid, "description": descriptions.get(tid, "Mapped ATT&CK technique")} for tid in seen]

def enrich_finding(f: dict) -> dict:
    f = dict(f)
    f["detection"] = _infer_detection_label(f)
    f["owasp"] = _infer_owasp_value(f)
    f["engine"] = _infer_engine_name(f)
    _apply_compliance_fallbacks(f)
    _apply_evidex_validation(f)

    # Canonical evidence-integrity gate. Once EVIDEX says the evidence is
    # invalid, the finding is not eligible for the final report, risk score,
    # attack graph, or executive/release decision. Individual engines must
    # not be able to override this gate.
    if f.get("evidence_valid") is False:
        return {}

    # Heuristic path-traversal evidence must not claim a concrete filesystem
    # sink when the reported code is only creating an application-owned temp
    # file.
    if str(f.get("vuln_type") or "").lower() == "path_traversal":
        fp = str(f.get("file") or f.get("full_path") or "").replace("\\", "/").lower()
        snippet = str(f.get("snippet") or "")
        if "namedtemporaryfile(" in snippet.lower() and "filename" not in snippet.lower():
            return {}

    # Final scanner coverage credibility adjustments.
    # 1) TLS bypass is High by default unless exposure/prod/auth context proves Critical.
    rid_title = " ".join(str(f.get(k, "")) for k in ("rule_id", "title", "vuln_type", "snippet")).lower()
    if f.get("vuln_type") == "tls_bypass" and f.get("severity") == "Critical":
        ctx = " ".join(str(f.get(k, "")) for k in ("file", "snippet", "description", "evidence")).lower()
        if not any(x in ctx for x in ["prod", "production", "internet", "public", "payment", "auth", "token", "credential"]):
            f["severity"] = "High"
            f["priority"] = "P2"

    # 2) Language/rule-specific business impact to prevent cross-language leakage.
    if _needs_bi_replace(f.get("business_impact")) or any(x in str(f.get("business_impact", "")).lower() for x in ["pickle.loads", "yaml.load"]):
        lang = str(f.get("language") or f.get("file") or "").lower()
        if "binaryformatter" in rid_title or "typenamehandling" in rid_title or "datacontract" in rid_title or ".cs" in lang or "dotnet" in rid_title:
            f["business_impact"] = "Unsafe .NET deserialization can instantiate attacker-controlled types, leading to remote code execution, privilege escalation, or sensitive data exposure."
        elif "objectinputstream" in rid_title or "jackson" in rid_title or "snakeyaml" in rid_title or "xstream" in rid_title or "kafka" in rid_title or ".java" in lang:
            f["business_impact"] = "Unsafe Java/JVM deserialization or polymorphic type handling can trigger gadget chains, remote code execution, or message-consumer compromise."
        elif "unserialize" in rid_title or "phar" in rid_title or ".php" in lang:
            f["business_impact"] = "Unsafe PHP object deserialization can invoke gadget chains through magic methods, causing remote code execution, file access, or application takeover."
        elif "node" in rid_title or "serialize" in rid_title or "yaml" in rid_title:
            f["business_impact"] = "Unsafe Node.js dynamic parsing/deserialization can execute attacker-controlled payloads or poison application object state."

    # Big4 reporting precision enrichment: keep scanner output intact, but
    # normalize report-facing MITRE, business impact, remediation, and
    # static critical confidence optics using a central mapping catalog.
    _rk = _report_rule_key(f)
    if _rk in MITRE_BY_RULE:
        f["mitre"] = MITRE_BY_RULE[_rk]

    if _needs_bi_replace(f.get("business_impact")):
        mapped_impact = BUSINESS_IMPACT_BY_RULE.get(_rk)
        if mapped_impact:
            f["business_impact"] = mapped_impact

    if _needs_rem_replace(f.get("remediation")):
        mapped_remediation = REMEDIATION_BY_RULE.get(_rk)
        if mapped_remediation:
            f["remediation"] = mapped_remediation

    if _rk in CONFIG_CRITICAL_RULES and str(f.get("confidence", "")).upper() == "LOW":
        f["confidence"] = "Medium"
    # Priority is finalized after canonical severity calibration.
    f["fingerprint"] = hashlib.md5(
        f"{f.get('vuln_type')}|{f.get('file')}|{f.get('line')}".encode()
    ).hexdigest()
    f["detected_at"] = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    if "affected_files" not in f:
        f["affected_files"] = [f.get("file", "")]
        f["instances"] = 1
    # Part 3: ensure sink_category is set on every finding
    if not f.get("sink_category"):
        f["sink_category"] = "unknown"

    # Issue 2 FIX: IDOR with http sink_category is a misclassification — drop it.
    # The conflict-resolution in Phase 1 dedup handles the common case (same line
    # as SSRF), but this guard catches any IDOR on HTTP sinks that arrive solo.
    if f.get("vuln_type") == "api_idor" and f.get("sink_category") == "http":
        return {}   # signal to caller: discard this finding

    # V17.9 SEMANTIC HARDENING
    _vtype = str(f.get("vuln_type") or "").lower()
    _rid = str(f.get("rule_id") or "").upper()
    _ev = int(f.get("evidence_score") or f.get("evidence_quality") or 0)
    _taint_ok = bool(f.get("taint_validated") or f.get("evidence_validation_detail", {}).get("taint_validated"))
    _sink_ok = bool(f.get("sink_validated") or f.get("evidence_validation_detail", {}).get("sink_valid"))
    _static_text = " ".join(str(f.get(k) or "") for k in ("snippet", "evidence", "description")).lower()

    # Canonical severity calibration: validated source/sink vulnerabilities
    # must not remain Low solely because runtime exploitation was not performed.
    if _vtype in {"path_traversal", "ssrf"} and (_taint_ok or (_sink_ok and _ev >= 90)):
        if str(f.get("severity") or "").title() == "Low":
            f["severity"] = "Medium"
    if _vtype in {"nosql_injection", "sql_injection", "command_injection"} and _sink_ok and _ev >= 90:
        if str(f.get("severity") or "").title() == "Low":
            f["severity"] = "Medium"

    # Deterministic static evidence: an actual PEM private-key block is HIGH
    # confidence for secret presence, even when live validation is disabled.
    if _vtype == "hardcoded_secret" and ("private key" in _static_text or "begin rsa private key" in _static_text or _rid == "PRIVATE_KEY_HEADER"):
        f["severity"] = "High"
        f["evidence_confidence"] = "HIGH"
        f["context_confidence"] = "MEDIUM"
        f["runtime_validation_status"] = "NOT_VALIDATED"
    elif _vtype == "weak_crypto" and ("md5" in _static_text or _rid == "MD5_USAGE"):
        f["severity"] = "Medium"
        f["evidence_confidence"] = "HIGH"
        f["context_confidence"] = "MEDIUM"
        f["runtime_validation_status"] = "NOT_APPLICABLE"

    # Recompute priority after all severity calibration.
    f["priority"] = PRIORITY_MAP.get(str(f.get("severity") or "Medium"), "P4")

    if _ev >= 90 or _taint_ok:
        f.setdefault("evidence_confidence", "HIGH")
    elif _ev >= 70:
        f.setdefault("evidence_confidence", "MEDIUM")
    else:
        f.setdefault("evidence_confidence", "LOW")
    if _taint_ok: f["evidence_confidence"] = "HIGH"
    f.setdefault("context_confidence", "MEDIUM" if _sink_ok else "LOW")
    f.setdefault("runtime_validation_status", "NOT_PERFORMED")
    f["confidence_basis"] = "STATIC_EVIDENCE_SEPARATE_FROM_RUNTIME_VALIDATION"

    # Compute exploitability before confidence scoring so HIGH exploitability is reflected.
    f["exploitability"] = _compute_exploitability(f)
    if f.get("severity") == "Critical" and str(f.get("exploitability", "")).lower() == "low":
        # Static RCE/deserialization/auth-bypass style findings are not proven taint flows,
        # but should not present as Critical with LOW exploitability in executive reports.
        f["exploitability"] = "Medium"
    # V17.9 confidence model: evidence confidence is independent of runtime exploitability.
    _ev = int(f.get("evidence_score") or f.get("evidence_quality") or 0)
    _taint_ok = bool(f.get("taint_validated") or f.get("evidence_validation_detail", {}).get("taint_validated"))
    _sink_ok = bool(f.get("sink_validated") or f.get("evidence_validation_detail", {}).get("sink_valid"))
    if f.get("evidence_confidence") == "HIGH" or _taint_ok or _ev >= 90:
        conf_score = 90
    elif _ev >= 70 or _sink_ok:
        conf_score = 75
    else:
        conf_score = 55
    f["confidence_score"] = min(conf_score, 100)
    f["confidence_label"] = "HIGH" if conf_score >= 75 else ("MEDIUM" if conf_score >= 55 else "LOW")
    f["confidence"] = f["confidence_label"]
    f.setdefault("evidence_confidence", f["confidence_label"])
    f.setdefault("context_confidence", "MEDIUM" if _sink_ok else "LOW")
    f.setdefault("runtime_validation_status", "NOT_PERFORMED")
    f["confidence_basis"] = "STATIC_EVIDENCE_SEPARATE_FROM_RUNTIME_VALIDATION"

    # Issue 1: always expose occurrence_count for report visibility
    # Issue 2 FIX: guarantee unique affected_files — use dict.fromkeys to preserve order
    if "affected_files" in f:
        f["affected_files"] = list(dict.fromkeys(p for p in f["affected_files"] if p))
    f["occurrence_count"]  = len(f.get("occurrences", [])) or f.get("instances", 1)
    f["unique_file_count"] = len(set(
        o.get("file","") for o in f.get("occurrences", [{"file": f.get("file","")}])
    ))
    if "occurrences" not in f:
        f["occurrences"] = [_occurrence_from_finding(f)]
    for field in ["pci_dss", "nist", "iso27001", "soc2", "exploitability",
                  "taint_path", "confidence", "cve_note", "attack_scenario"]:
        f.setdefault(field, "")
    if not f.get("cve") and not f.get("cve_note"):
        f["cve_note"] = f"Code-level vulnerability (no CVE). Mapped to {f.get('cwe', 'CWE')}."
    return f


def severity_distribution(findings: list[dict]) -> dict[str, int]:
    dist: dict = {s: 0 for s in SEVERITY_ORDER}
    for f in findings:
        dist[f.get("severity", "Info")] = dist.get(f.get("severity", "Info"), 0) + 1
    return dist


def group_by_severity(findings: list[dict]) -> list[dict]:
    return sorted(
        findings,
        key=lambda f: (
            SEVERITY_ORDER.get(f.get("severity", "Info"), 99),
            -CONFIDENCE_RANK.get(f.get("confidence", ""), 0),
        )
    )


def _score_sbom_entry(pkg: dict) -> dict:
    pkg = dict(pkg)
    cvss = _safe_float(pkg.get("cvss"))
    if pkg.get("reachable") and cvss > 0:
        pkg["risk_score"]  = min(100.0, round(cvss * 10, 1))
        pkg["fingerprint"] = hashlib.md5(
            f"{pkg.get('name', '')}|{pkg.get('cve', '')}".encode()
        ).hexdigest()
        pkg["detected_at"] = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    else:
        pkg.setdefault("risk_score", 0)
    return pkg


