def _evidex_text(value: Any) -> str:
    if isinstance(value, (list, tuple, set)):
        return " ".join(_evidex_text(x) for x in value)
    if isinstance(value, dict):
        return " ".join(_evidex_text(v) for v in value.values())
    return str(value or "").strip()

def _evidex_has_concrete_text(value: Any) -> bool:
    text = _evidex_text(value).strip()
    if not text:
        return False
    low = text.lower().strip()
    if low in _EVIDEX_GENERIC_TOKENS:
        return False
    # A useful code/evidence fragment normally contains an operator, call,
    # identifier, path, assignment, literal, or a multi-word explanation.
    if len(text) < 4:
        return False
    return bool(
        any(ch in text for ch in "()[]{}=.;:/\\'\"")
        or " " in text
        or "_" in text
    )

def _evidex_extract_evidence(finding: dict) -> list[str]:
    # Occurrences are authoritative after grouping/pruning. Never let stale
    # pre-group top-level evidence validate an occurrence that was removed or
    # belongs to another file. This is the core occurrence-integrity rule.
    occs = [o for o in (finding.get("occurrences") or []) if isinstance(o, dict)]
    values = []
    if occs:
        for occ in occs:
            for key in ("snippet", "evidence", "sink_evidence", "taint_path"):
                value = occ.get(key)
                if _evidex_has_concrete_text(value):
                    values.append(_evidex_text(value))
        # Include finding-level taint/source only when it is also represented
        # by at least one retained occurrence. Do not reuse aggregated evidence
        # arrays from the pre-pruning phase.
        for key in ("taint_path", "source_expr", "sink_expr"):
            value = finding.get(key)
            if _evidex_has_concrete_text(value) and _evidex_text(value) in values:
                values.append(_evidex_text(value))
    else:
        for key in (
            "evidence", "evidence_snippet", "code_evidence", "sink_evidence",
            "taint_path", "source_expr", "sink_expr", "snippet",
        ):
            value = finding.get(key)
            if _evidex_has_concrete_text(value):
                values.append(_evidex_text(value))
    return list(dict.fromkeys(values))

def _evidex_strip_comments(text: str) -> str:
    """
    Remove source comments without corrupting executable strings.

    Handles:
      - // line comments
      - # line comments
      - -- line comments
      - /* ... */ block comments
      - single/double/backtick quoted strings

    Comment markers inside quoted strings are preserved.
    This is intentionally lexical rather than a full language parser.
    """
    source = str(text or "")
    cleaned = []
    block_comment = False

    for raw_line in source.splitlines():
        out = []
        i = 0
        quote = None
        escaped = False

        while i < len(raw_line):
            ch = raw_line[i]
            nxt = raw_line[i + 1] if i + 1 < len(raw_line) else ""

            if block_comment:
                if ch == "*" and nxt == "/":
                    block_comment = False
                    i += 2
                    continue
                i += 1
                continue

            if quote:
                out.append(ch)

                if escaped:
                    escaped = False
                elif ch == "\\":
                    escaped = True
                elif ch == quote:
                    quote = None

                i += 1
                continue

            # Start of quoted string.
            if ch in ("'", '"', "`"):
                quote = ch
                out.append(ch)
                i += 1
                continue

            # C/Java/JavaScript block comment.
            if ch == "/" and nxt == "*":
                block_comment = True
                i += 2
                continue

            # C/Java/JavaScript/TypeScript line comment.
            # Preserve URL schemes such as http:// and https://.
            if ch == "/" and nxt == "/":
                if i > 0 and raw_line[i - 1] == ":":
                    out.append(ch)
                    out.append(nxt)
                    i += 2
                    continue
                break

            # SQL line comment.
            if ch == "-" and nxt == "-":
                break

            # Python/Shell/YAML style comment.
            if ch == "#":
                break

            out.append(ch)
            i += 1

        line = "".join(out).strip()

        if line:
            cleaned.append(line)

    return "\n".join(cleaned)



def _evidex_is_import_line(line: str) -> bool:
    """Return True when a line is an import/module declaration."""
    stripped = str(line or "").strip().lower()

    return (
        stripped.startswith("import ")
        or stripped.startswith("from ")
        or stripped.startswith("require(")
        or stripped.startswith("require ")
        or stripped.startswith("using ")
        or stripped.startswith("include ")
    )


def _evidex_sink_candidates(finding: dict, evidence_text: str) -> set[str]:
    """
    Identify concrete executable security sinks.

    EVIDEX rules:
      * comments are not executable evidence;
      * import statements are not sinks;
      * explicit sink metadata is considered;
      * NoSQL/ORM query methods are recognized explicitly;
      * mass-assignment sinks are recognized explicitly.
    """
    raw_text = str(evidence_text or "")
    text = _evidex_strip_comments(raw_text).lower()

    candidates: set[str] = set()

    # Remove import-only lines before sink matching.
    executable_lines = [
        line
        for line in text.splitlines()
        if not _evidex_is_import_line(line)
    ]
    executable_text = "\n".join(executable_lines)

    explicit = _evidex_text(
        finding.get("sink_category")
        or finding.get("sink")
        or finding.get("sink_expr")
    ).lower()

    explicit_map = {
        "sql": "sql",
        "database": "sql",
        "sql query": "sql",

        # Stable R-SecOpsX sink taxonomy aliases.
        "jdbc": "sql",
        "jpa": "sql",
        "hibernate": "sql",
        "ldap": "ldap",
        "xpath": "xpath",
        "http": "xss",
        "html": "xss",
        "response": "xss",

        "command": "command",
        "shell": "command",
        "os command": "command",
        "code": "code",
        "code execution": "code",
        "execution": "code",
        "network": "ssrf",
        "ssrf": "ssrf",
        "url": "ssrf",
        "xss": "xss",
        "html": "xss",
        "deserialization": "deserialization",
        "file": "file",
        "filesystem": "file",
        "redirect": "redirect",
        "template": "template",
        "ai / llm workflow": "llm",
        "llm": "llm",
        "mass assignment": "mass_assignment",
        "mass_assignment": "mass_assignment",
        "nosql": "nosql",
        "no sql": "nosql",
        "mongodb": "nosql",
        "mongo": "nosql",
    }

    for token, canonical in explicit_map.items():
        if token in explicit:
            candidates.add(canonical)

    if "weak_crypto" in str(finding.get("vuln_type") or "").lower() or "MD5_USAGE" in str(finding.get("rule_id") or "").upper():
        candidates.add("crypto")

    # Existing sink aliases, but only against executable source.
    for canonical, aliases in _EVIDEX_SINK_ALIASES.items():
        if any(str(alias).lower() in executable_text for alias in aliases):
            candidates.add(canonical)

    # Concrete NoSQL sinks: do not treat generic ORM methods as NoSQL.
    # Sequelize/relational Model.findOne() is normal data access.
    if re.search(r"\$(?:where|regex|ne|gt|gte|lt|lte|in|nin)\b", executable_text, re.I):
        candidates.add("nosql")
    elif re.search(
        r"(?:\b(?:db|database|collection|collections|mongo|mongodb|mongoose)\b(?:\s*\.\s*\w+)*\s*\.\s*(?:find|findOne|findOneAnd(?:Update|Delete)|updateOne|updateMany|deleteOne|deleteMany)\s*\([^)]*(?:req\.|request\.|body|query|params)\b)",
        executable_text, re.I,
    ):
        candidates.add("nosql")

    # Concrete mass-assignment / overposting sinks require the request object
    # itself (or an object spread) to reach persistence.
    if re.search(
        r"\.(?:create|update|updateOne|updateMany|findOneAndUpdate|save)\s*\(\s*(?:req\.body|request\.body|body|payload|data)\b|"
        r"\.(?:create|update|updateOne|updateMany|findOneAndUpdate)\s*\(\s*\{[^}]*\.\.\.\s*(?:req\.body|request\.body|body|payload)\b|"
        r"\bObject\.assign\s*\([^)]*(?:req\.body|request\.body|payload)\b",
        executable_text, re.I,
    ):
        candidates.add("mass_assignment")

    # -----------------------------------------------------------------
    # Taint-path terminal sink inference
    # -----------------------------------------------------------------
    # Benchmark and scanner findings can carry compact paths such as:
    #   Query -> fetch
    #   Request -> axios
    #   query -> find(
    #   body -> user
    #
    # These paths are already source-to-sink evidence, but the terminal
    # expression may not contain the parentheses/receiver syntax required
    # by the textual sink aliases above. Infer only from a validated-looking
    # source->sink path; do not infer from arbitrary snippets.
    taint_path = _evidex_text(finding.get("taint_path")).strip().lower()
    if "->" in taint_path:
        parts = [part.strip() for part in taint_path.split("->") if part.strip()]
        if len(parts) >= 2:
            terminal = parts[-1].strip()
            terminal = terminal.rstrip("()[]{};,.:")

            ssrf_terminals = {
                "fetch", "axios", "axios.get", "axios.post", "axios.put",
                "axios.delete", "httpclient", "http.get", "http.post",
                "urlopen", "request", "requests.get", "requests.post",
            }
            nosql_terminals = {
                "find", "findone", "findby", "findoneandupdate",
                "findoneanddelete", "updateone", "updatemany",
                "deleteone", "deletemany", "collection.find",
                "collection.findone",
            }

            if terminal in ssrf_terminals:
                candidates.add("ssrf")

            if terminal in nosql_terminals:
                candidates.add("nosql")

            # For mass-assignment, the benchmark's source->object flow is
            # itself the concrete security evidence. Require an actual taint
            # path so import/comment-only false positives are unaffected.
            vuln_type = _evidex_text(finding.get("vuln_type")).lower()
            if (
                ("mass_assignment" in vuln_type or "mass assignment" in vuln_type)
                and len(parts) >= 2
            ):
                candidates.add("mass_assignment")

    return candidates

def _validate_security_evidence(
    finding: dict,
    *,
    require_sink: bool = False,
) -> dict:
    """
    EVIDEX evidence/sink validator.

    Returns a stable dictionary:
      valid                 overall evidence quality
      evidence_present     concrete code/evidence exists
      sink_present         a sink/category is explicitly or implicitly visible
      sink_valid            sink is consistent with vuln_type (when applicable)
      taint_validated       real source->sink evidence is present
      evidence_score       0..100 quality score
      reason                concise QA explanation
      evidence              normalized evidence fragments

    `require_sink=True` is useful for sink-centric benchmark cases. Normal
    report enrichment leaves it False because some findings (for example
    governance/configuration and hardcoded-secret findings) do not have a
    callable sink.
    """
    if not isinstance(finding, dict):
        return {
            "valid": False,
            "evidence_present": False,
            "sink_present": False,
            "sink_valid": False,
            "taint_validated": False,
            "evidence_score": 0,
            "reason": "Finding is not a dictionary.",
            "evidence": [],
        }

    evidence = _evidex_extract_evidence(finding)
    combined = "\n".join(evidence)
    vuln_type = str(finding.get("vuln_type") or "").lower().strip()
    rule_id = str(finding.get("rule_id") or "").upper().strip()
    taint_path = _evidex_text(finding.get("taint_path"))

    taint_validated = bool(
        taint_path and "->" in taint_path and
        len(taint_path.split("->")) >= 2
    )

    # Normalize helper output defensively. Older V8 patches returned lists;
    # EVIDEX internally requires set semantics for intersection/add operations.
    try:
        sink_candidates = set(_evidex_sink_candidates(finding, combined) or [])
    except (TypeError, AttributeError):
        sink_candidates = set()

    expected: set[str] = set()

    for key, sinks in _EVIDEX_VULN_TO_SINK.items():
        if vuln_type == key or key in vuln_type:
            if isinstance(sinks, str):
                expected.add(sinks)
            else:
                expected.update(set(sinks or []))

    # Robust aliases for scanner taxonomy variants.
    if "mass_assignment" in vuln_type or "mass assignment" in vuln_type:
        expected.add("mass_assignment")

    if (
        "nosql" in vuln_type
        or "no_sql" in vuln_type
        or "mongodb" in vuln_type
        or "mongo" in vuln_type
    ):
        expected.add("nosql")

    if "ssrf" in vuln_type:
        expected.add("ssrf")

    if "sql" in vuln_type:
        expected.add("sql")

    # Rule IDs are useful for AI findings whose vuln_type may be generic.
    if rule_id.startswith("LLM") or rule_id.startswith("AGENT_"):
        expected.add("llm" if "LLM" in rule_id else "command")

    # Final normalization protects against legacy list-valued contracts.
    sink_candidates = set(sink_candidates or [])
    expected = set(expected or [])

    sink_required = require_sink or bool(expected)
    sink_present = bool(sink_candidates)

    if expected:
        sink_valid = bool(sink_candidates & expected)
    else:
        # Findings with no defined sink contract are not penalized for lacking
        # a callable sink; explicit sink evidence, if present, is still valid.
        sink_valid = True if not sink_required else sink_present

    score = 0
    if evidence:
        score += 45
    if any("(" in e or "=" in e or "->" in e for e in evidence):
        score += 15
    if sink_present:
        score += 20
    if sink_valid:
        score += 10
    if taint_validated:
        score += 10
    score = min(score, 100)

    valid = bool(evidence) and sink_valid and (not sink_required or sink_present)

    if taint_validated and sink_valid:
        reason = "Concrete source-to-sink evidence validated."
    elif valid and sink_present:
        reason = "Concrete code evidence and sink consistency validated."
    elif valid:
        reason = "Concrete evidence validated; no callable sink is required for this finding type."
    elif not evidence:
        reason = "No concrete security evidence was supplied."
    elif sink_required and not sink_present:
        reason = "Concrete evidence exists, but no security sink was identified."
    elif not sink_valid:
        reason = "Evidence exists, but the identified sink is inconsistent with the finding type."
    else:
        reason = "Security evidence did not satisfy the validation contract."

    return {
        "valid": valid,
        "evidence_present": bool(evidence),
        "sink_present": sink_present,
        "sink_valid": sink_valid,
        "taint_validated": taint_validated,
        "evidence_score": score,
        "reason": reason,
        "evidence": evidence,
        "sink_candidates": sorted(sink_candidates),
        "expected_sinks": sorted(expected),
    }

def _infer_rule_id(finding: dict) -> str:
    """Return a stable canonical rule ID without overwriting an existing ID."""
    existing = str(finding.get("rule_id") or "").strip()
    if existing:
        return existing
    vuln_type = str(finding.get("vuln_type") or "").strip().lower()
    mapping = {
        "ssrf": "SSRF",
        "nosql_injection": "NOSQL_INJECTION",
        "sql_injection": "SQL_INJECTION",
        "mass_assignment": "MASS_ASSIGNMENT",
        "command_injection": "COMMAND_INJECTION",
        "code_injection": "CODE_INJECTION",
        "path_traversal": "PATH_TRAVERSAL",
        "xss": "XSS",
        "xxe": "XXE",
        "open_redirect": "OPEN_REDIRECT",
        "insecure_deserialization": "INSECURE_DESERIALIZATION",
        "template_injection": "TEMPLATE_INJECTION",
        "spel_injection": "SPEL_INJECTION",
        "hardcoded_secret": "HARDCODED_SECRET",
        "idor": "IDOR",
    }
    if vuln_type in mapping:
        return mapping[vuln_type]
    normalized = vuln_type.replace("-", "_").replace(" ", "_")
    return normalized.upper() if normalized else "UNKNOWN"


def _evidex_infer_sink_category(finding: dict, validation: dict | None = None) -> str:
    """Map EVIDEX sink candidates to the stable report taxonomy."""
    validation = validation or {}
    vuln_type = str(finding.get("vuln_type") or "").strip().lower()
    candidates = set(validation.get("sink_candidates") or [])
    if vuln_type == "mass_assignment":
        return "model_binding"
    if vuln_type == "weak_crypto" or "crypto" in vuln_type:
        return "crypto"
    if vuln_type == "ssrf" or "ssrf" in candidates:
        return "http"
    if "nosql" in vuln_type or "nosql" in candidates:
        return "database"
    if "sql" in candidates:
        return "database"
    if "command" in candidates:
        return "command"
    if "code" in candidates:
        return "code"
    if "deserialization" in candidates:
        return "deserialization"
    if "xss" in candidates:
        return "html"
    if "template" in candidates:
        return "template"
    if "file" in candidates:
        return "filesystem"
    if "redirect" in candidates:
        return "redirect"
    if "llm" in candidates:
        return "AI / LLM Workflow"
    return "unknown"


def _apply_evidex_validation(finding: dict) -> dict:
    """Attach EVIDEX QA fields and enforce canonical evidence semantics."""
    vt = str(finding.get("vuln_type") or "").lower()
    rid = str(finding.get("rule_id") or "").upper()
    if vt in {"api_rate_limit", "api_abuse_missing_rate_limit"} or (rid.startswith("API_") and "RATE" in rid):
        finding.setdefault("finding_class", "control_gap")
        if finding.get("severity") == "High":
            finding["severity"] = "Medium"
        finding.setdefault("confidence", "Medium")
    finding["rule_id"] = _infer_rule_id(finding)
    result = _validate_security_evidence(finding)
    finding["evidence_validation_detail"] = result
    finding["evidence_validation"] = result.get("reason", "")
    finding["evidence_valid"] = bool(result.get("valid"))
    finding["evidence_score"] = int(result.get("evidence_score", 0))
    finding["evidence_quality"] = int(result.get("evidence_score", 0))
    finding["evidence_reason"] = result.get("reason", "")
    finding["sink_validated"] = bool(result.get("sink_valid"))
    finding["sink_category"] = _evidex_infer_sink_category(finding, result)
    if not finding.get("evidence_valid"):
        finding["confidence_score"] = min(int(finding.get("confidence_score", 0) or 0), 25)
        finding["confidence_label"] = "LOW"
        finding["confidence"] = "LOW"
    elif finding.get("finding_class") == "control_gap":
        finding["confidence_score"] = min(int(finding.get("confidence_score", 55) or 55), 55)
        finding["confidence_label"] = "MEDIUM"
        finding["confidence"] = "MEDIUM"
    return finding

def normalize_final_issue_group(finding: dict) -> dict:
    title = str(finding.get("title", "")).upper()
    vuln = str(finding.get("vuln_type", "")).upper()
    rule_id = str(finding.get("rule_id", "")).upper()

    # LLM/agent findings belong to the AI Security issue family in the
    # final report. Do not overwrite an explicit downstream framework value
    # unless it is the legacy generic "ai" marker.
    if (
        rule_id.startswith("LLM")
        or rule_id.startswith("AGENT_")
        or vuln.startswith("LLM_")
        or vuln.startswith("AGENT_")
    ):
        finding["issue_group"] = "AI / LLM Security"
        if str(finding.get("framework", "")).lower() == "ai":
            finding["framework"] = "AI Security"
        return finding

    if (
        rule_id == "SUPPLY_CHAIN_SCRIPT"
        or vuln == "SUPPLY_CHAIN_SCRIPT"
        or "SUPPLY CHAIN" in title
    ):
        finding["issue_group"] = "Supply Chain Security"
        if str(finding.get("framework", "")).lower() == "ai":
            finding["framework"] = "Application Security"
        return finding

    if "TENANT_ISOLATION" in title or "TENANT_ISOLATION" in vuln:
        finding["issue_group"] = "Broken Access Control / Business Logic"
        if str(finding.get("framework", "")).lower() == "ai":
            finding["framework"] = "Application Security"
    elif "GRAPHQL" in title or "GRAPHQL" in vuln:
        finding["issue_group"] = "API Security / GraphQL"
        finding["framework"] = "graphql"
    elif "IDOR" in title or "BOLA" in title or vuln in {"IDOR", "BOLA"}:
        finding["issue_group"] = "Broken Access Control / Business Logic"
    return finding



