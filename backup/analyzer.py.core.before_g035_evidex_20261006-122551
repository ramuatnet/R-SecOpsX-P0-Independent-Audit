def deduplicate(findings: list[dict]) -> list[dict]:
    # Level 1: exact per-file dedupe
    # When two findings share the same fingerprint (same file+line+vuln),
    # keep the one with the richer detection — TAINT-VALIDATED > Regex.
    seen_exact: dict[str, int] = {}  # fp -> index in phase1
    phase1: list[dict] = []
    for f in findings:
        fp = _path_fp(f)
        if fp not in seen_exact:
            seen_exact[fp] = len(phase1)
            phase1.append(f)
        else:
            existing_idx = seen_exact[fp]
            existing     = phase1[existing_idx]

            # Part 5+6: Conflict resolution — same line, different vuln_type
            # HTTP sink SSRF wins; remove IDOR classification
            e_vt = existing.get("vuln_type", "")
            f_vt = f.get("vuln_type", "")
            e_sc = existing.get("sink_category", "")
            f_sc = f.get("sink_category", "")

            # Issue 4 FIX: generic rule — sink_category="http" SSRF wins.
            # Handles SSRF vs IDOR and any future http-sink misclassification.
            both_cats = {e_sc, f_sc}
            if "http" in both_cats or {e_vt, f_vt} == {"ssrf", "api_idor"}:
                # Keep whichever is SSRF; discard IDOR or non-SSRF http finding
                if f_vt == "ssrf" or f_sc == "http":
                    phase1[existing_idx] = f
                # else existing is already the right one (ssrf or http)
                continue

            # Upgrade to TAINT-VALIDATED when incoming has real taint path
            if (f.get("detection") == "TAINT-VALIDATED"
                    and existing.get("detection") != "TAINT-VALIDATED"):
                phase1[existing_idx] = f

    # Level 2: root-cause grouping
    groups: dict[str, dict] = {}
    for f in phase1:
        rck = _root_cause_key(f)
        if rck not in groups:
            entry = dict(f)
            entry["occurrences"]    = [_occurrence_from_finding(f)]
            first_file = f.get("file") or f.get("file_path") or f.get("full_path") or ""
            entry["affected_files"] = [first_file] if first_file else []
            entry["instances"]      = 1
            groups[rck] = entry
        else:
            existing      = groups[rck]
            incoming_rank = CONFIDENCE_RANK.get(f.get("confidence", ""), 0)
            existing_rank = CONFIDENCE_RANK.get(existing.get("confidence", ""), 0)

            if incoming_rank > existing_rank:
                occ_bak  = existing["occurrences"]
                aff_bak  = existing["affected_files"]
                inst_bak = existing["instances"]
                existing_engine = existing.get("engine")
                groups[rck]                   = dict(f)
                groups[rck]["occurrences"]    = occ_bak
                groups[rck]["affected_files"] = aff_bak
                groups[rck]["instances"]      = inst_bak

                # Preserve legitimate upstream engine attribution when the
                # representative changes because of confidence ranking.
                if existing_engine:
                    groups[rck]["engine"] = existing_engine

            occ = _occurrence_from_finding(f)
            # Issue 4: dedup by (file, line) — same location from regex + fallback
            # must not create two entries in the occurrence list
            _seen_locs = {(o["file"], o["line"]) for o in groups[rck]["occurrences"]}
            if (occ["file"], occ["line"]) not in _seen_locs:
                groups[rck]["occurrences"].append(occ)
            fp_path = f.get("file", "")
            if fp_path and fp_path not in groups[rck]["affected_files"]:
                groups[rck]["affected_files"].append(fp_path)
            groups[rck]["instances"] = len(groups[rck]["occurrences"])
            # Belt-and-suspenders: keep affected_files unique after every merge step
            groups[rck]["affected_files"] = list(dict.fromkeys(groups[rck]["affected_files"]))

            # Fix 1: promote detection label — TAINT-VALIDATED beats regex
            incoming_det = f.get("detection", "")
            existing_det = groups[rck].get("detection", "")
            if incoming_det == "TAINT-VALIDATED" and existing_det != "TAINT-VALIDATED":
                groups[rck]["detection"] = "TAINT-VALIDATED"
                # also carry over the real taint_path if current one is empty
                if f.get("taint_path") and "->" in str(f.get("taint_path", "")):
                    if not groups[rck].get("taint_path") or "->" not in str(groups[rck].get("taint_path", "")):
                        groups[rck]["taint_path"] = f["taint_path"]

            # Fix 2: for secrets, promote to highest severity among occurrences
            if f.get("vuln_type") == "hardcoded_secret":
                sev_rank = {"Critical": 4, "High": 3, "Medium": 2, "Low": 1, "Info": 0}
                incoming_sev = f.get("severity", "Medium")
                existing_sev  = groups[rck].get("severity", "Medium")
                if sev_rank.get(incoming_sev, 0) > sev_rank.get(existing_sev, 0):
                    groups[rck]["severity"] = incoming_sev
                    groups[rck]["priority"] = {
                        "Critical":"P1","High":"P2","Medium":"P3","Low":"P4"
                    }.get(incoming_sev, "P3")

    # Explicit B2 deduplication pipeline:
    #
    #   exact-location dedupe
    #        ->
    #   root-cause grouping
    #        ->
    #   semantic duplicate consolidation
    #        ->
    #   occurrence normalization
    #
    # The two post-processing stages are helpers defined later in this
    # module. They are resolved when deduplicate() executes, after the
    # module has completed loading.
    grouped_findings = list(groups.values())
    grouped_findings = _merge_semantic_duplicate_findings(grouped_findings)
    grouped_findings = _qa_normalize_occurrences(grouped_findings)
    return grouped_findings


