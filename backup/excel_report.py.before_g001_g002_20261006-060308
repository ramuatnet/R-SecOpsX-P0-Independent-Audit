def _sanitize_excel_value(value):
    """Remove OOXML-forbidden C0 control characters at the XLSX boundary."""
    if value is None or not isinstance(value, str):
        return value
    return re.sub(r"[\x00-\x08\x0B\x0C\x0E-\x1F]", "", value)

